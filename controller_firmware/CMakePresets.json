{
  "version": 3,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "STM32G474 firmware",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "sim",
      "displayName": "Host simulator and tests",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-sim",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default" },
    { "name": "sim", "configurePreset": "sim" }
  ],
  "testPresets": [
    { "name": "sim", "configurePreset": "sim", "output": { "outputOnFailure": true } }
  ]
}
